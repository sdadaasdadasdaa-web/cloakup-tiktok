# Cloaker Genérico — Variáveis de Ambiente

# -----------------------------------------------------------
# RECOMENDADO: configurar tudo via painel admin (/admin)
# estas variáveis servem de fallback / setup inicial.
# -----------------------------------------------------------

# URL do seu site/landing page (destino do lead qualificado - "site BLACK")
# Definir aqui substitui o valor de blackUrl no painel.
NEXT_PUBLIC_BLACK_URL=https://seu-site.com

# URL do site de disfarce (onde bloqueados bots/PCs/redirecionam - "site WHITE")
NEXT_PUBLIC_DECOY_URL=https://www.tiktok.com

# URL base do cloaker (usada para redirects internos)
CLOAKER_BASE_URL=https://seu-site.com

# Modo de operação: "moderate" (mobile sem params vai para captura)
# ou "strict" (mobile sem params é bloqueado imediatamente)
CLOAKER_MODE=moderate

# Segredo JWT para geração de tokens de bypass (mude em produção!)
CLOAKER_SECRET_KEY=seu-secret-key-mude-isto-em-producao

# Notificações (opcional) — canal onde chega alerta de novos leads
CLOAKER_TELEGRAM_BOT_TOKEN=
CLOAKER_TELEGRAM_CHAT_ID=

# IP de admin para whitelist automática (opcional)
CLOAKER_ADMIN_IP=
